# ---------------------------------------------------------------------------
# Hasil terjemahan dan file kerja: JANGAN pernah di-commit (bisa berisi karya berhak cipta)
# ---------------------------------------------------------------------------
hasil-terjemahan/
**/work/
**/output/
*_ID_*/
*.apply-report.json
eval-results.json

# ---------------------------------------------------------------------------
# Dokumen sumber / hasil dalam format umum (diblokir di mana pun)
# ---------------------------------------------------------------------------
*.pdf
*.epub
*.mobi
*.azw
*.azw3
*.djvu
*.doc
*.docx
*.odt
*.rtf
*.ppt
*.pptx
*.odp
*.xls
*.xlsx
*.ods
*.idml
*.srt
*.vtt
*.ass
*.ssa
*.sub

# ---------------------------------------------------------------------------
# Pengecualian: fixture buatan sendiri dan aset demo BOLEH dilacak
# (folder induknya tidak diabaikan, jadi negasi ini berlaku)
# ---------------------------------------------------------------------------
!tests/fixtures/**
!docs/demo/**

# ---------------------------------------------------------------------------
# Python, build, cache
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.env
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Catatan progres pengembangan lokal (tidak dilacak di git)
PROGRESS.md

